; MILI-BOT EVOLUTION (Wersja ze sterownikami przetrwania dla UserPatch 1.5)

; =========================================================
; 0. ODCZYT GENÓW Z PYTHONA
; =========================================================
(defconst f-town-size {{TOWN_SIZE}})

(defconst f-feudal-wood-percent {{FEUDAL_WOOD_PERCENT}})
(defconst f-feudal-gold-percent {{FEUDAL_GOLD_PERCENT}})
(defconst f-feudal-stone-percent {{FEUDAL_STONE_PERCENT}})
(defconst f-feudal-food-percent {{FEUDAL_FOOD_PERCENT}})

(defconst f-castle-wood-percent {{CASTLE_WOOD_PERCENT}})
(defconst f-castle-gold-percent {{CASTLE_GOLD_PERCENT}})
(defconst f-castle-stone-percent {{CASTLE_STONE_PERCENT}})
(defconst f-castle-food-percent {{CASTLE_FOOD_PERCENT}})

(defconst f-feudal-vills {{FEUDAL_VILLS}})
(defconst f-castle-vills {{CASTLE_VILLS}})

(defconst f-boar-hunting {{BOAR_HUNTING}})
(defconst f-boar-hunters {{BOAR_HUNTERS}})

(defconst f-market {{BUILD_MARKET}})
(defconst f-blacksmith {{BUILD_BLACKSMITH}})
(defconst f-archery {{BUILD_ARCHERY}})
(defconst f-stable {{BUILD_STABLE}})
(defconst f-tower {{BUILD_TOWER}})
(defconst f-palisade {{BUILD_PALISADE}})
(defconst f-castle {{BUILD_CASTLE}})
(defconst f-siege {{BUILD_SIEGE}})

(defconst f-militia-count {{MILITIA_COUNT}})
(defconst f-archer-count {{ARCHER_COUNT}})
(defconst f-skirm-count {{SKIRM_COUNT}})
(defconst f-scout-count {{SCOUT_COUNT}})
(defconst f-spearman-count {{SPEARMAN_COUNT}})
(defconst f-knight-count {{KNIGHT_COUNT}})
(defconst f-ram-count {{RAM_COUNT}})

(defconst f-attack-group-size {{ATTACK_GROUP_SIZE}})
(defconst f-target-eco {{TARGET_ECO}})
(defconst f-attack-percent {{ATTACK_PERCENT}})
(defconst f-min-attack-group {{MIN_ATTACK_GROUP}})

(defconst f-army-size-with-siege {{ARMY_SIZE_WITH_SIEGE}})
(defconst f-army-size-no-siege {{ARMY_SIZE_NO_SIEGE}})

(defconst f-retreat-threshold {{RETREAT_THRESHOLD}})
(defconst f-attack-groups {{ATTACK_GROUPS}})
(defconst f-feudal-aggression {{FEUDAL_AGGRESSION}})

(defconst f-loom {{TECH_LOOM}})
(defconst f-wheelbarrow {{TECH_WHEELBARROW}})
(defconst f-doubleaxe {{TECH_DOUBLE_AXE}})
(defconst f-horsecollar {{TECH_HORSE_COLLAR}})
(defconst f-goldmining {{TECH_GOLD_MINING}})
(defconst f-fletching {{TECH_FLETCHING}})
(defconst f-paddedarcher {{TECH_PADDED_ARCHER}})
(defconst f-forging {{TECH_FORGING}})
(defconst f-scalemail {{TECH_SCALE_MAIL}})
(defconst f-bloodlines {{TECH_BLOODLINES}})



(defconst gl-target-player 10)

; =========================================================
; AWARYJNY HANDEL NA RYNKU
; =========================================================
(defrule
    (building-type-count-total market > 0)
    (wood-amount > 1000)
    (gold-amount < 200)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
)

(defrule
    (building-type-count-total market > 0)
    (food-amount > 1000)
    (gold-amount < 200)
    (can-sell-commodity food)
=>
    (sell-commodity food)
)

; =========================================================
; 1. SYSTEM CHRONIĄCY PRZED ZATORAMI (ECO DEADLOCK SAFETY)
; =========================================================
; Bezpiecznik: Jeśli jedzenie spadnie dramatycznie podczas odkładania do Escrow,
; zwalniamy surowce, aby nie zatrzymać produkcji wieśniaków w centrach.
(defrule
    (current-age == feudal-age)
    (food-amount < 50)
    (unit-type-count villager < 18)
=>
    (release-escrow food)
    (release-escrow gold)
)

; =========================================================
; 2. ZDROWE ZASADY GOSPODARCZE (NATIVE "COMMON SENSE")
; =========================================================
(defrule
    (true)
=>
    ; Mikro-zarządzanie wieśniakami
    (set-strategic-number sn-cap-civilian-explorers 0)              ; Zakaz włóczenia się wieśniaków po mapie
    (set-strategic-number sn-intelligent-gathering 1)               ; Optymalizacja wyboru najbliższych drzew/złota

    ; Ograniczenie dystansu spacerów po surowce (zapobiega chodzeniu przez pół mapy)
    (set-strategic-number sn-maximum-wood-drop-distance 20)
    (set-strategic-number sn-maximum-food-drop-distance 20)
    (set-strategic-number sn-maximum-gold-drop-distance 20)
    (set-strategic-number sn-maximum-stone-drop-distance 20)

    ; Budowanie obozów blisko surowców
    (set-strategic-number sn-lumber-camp-max-distance 15)
    (set-strategic-number sn-mining-camp-max-distance 15)
    (disable-self)
)

; =========================================================
; 3. INICJALIZACJA ER (FURTKI EWOLUCYJNE)
; =========================================================
(defrule
    (current-age == dark-age)
=>
    (set-strategic-number sn-percent-civilian-builders 25)
    (set-strategic-number sn-percent-civilian-gatherers 75)
    (set-strategic-number sn-number-explore-groups 1)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-maximum-town-size f-town-size)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-food-gatherer-percentage 75)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (set-strategic-number sn-enable-boar-hunting f-boar-hunting)
    (set-strategic-number sn-minimum-boar-hunt-group-size f-boar-hunters)
    (set-strategic-number sn-minimum-boar-lure-group-size 1)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (disable-self)
)

(defrule
    (current-age == feudal-age)
=>
    (set-strategic-number sn-percent-civilian-builders 15)
    (set-strategic-number sn-percent-civilian-gatherers 85)
    ; Furtka: Ewolucja steruje gospodarką feudalną
    (set-strategic-number sn-wood-gatherer-percentage f-feudal-wood-percent)
    (set-strategic-number sn-gold-gatherer-percentage f-feudal-gold-percent)
    (set-strategic-number sn-stone-gatherer-percentage f-feudal-stone-percent)
    (set-strategic-number sn-food-gatherer-percentage f-feudal-food-percent)
    (set-strategic-number sn-percent-attack-soldiers f-attack-percent)
    (disable-self)
)

(defrule
    (current-age >= castle-age)
=>
    (set-strategic-number sn-percent-civilian-builders 15)
    (set-strategic-number sn-percent-civilian-gatherers 85)
    ; Furtka: Ewolucja steruje gospodarką zamkową
    (set-strategic-number sn-wood-gatherer-percentage f-castle-wood-percent)
    (set-strategic-number sn-gold-gatherer-percentage f-castle-gold-percent)
    (set-strategic-number sn-stone-gatherer-percentage f-castle-stone-percent)
    (set-strategic-number sn-food-gatherer-percentage f-castle-food-percent)
    (set-strategic-number sn-percent-attack-soldiers f-attack-percent)
    (disable-self)
)

; =========================================================
; KRYTYCZNA INFRASTRUKTURA (Start i Ratusze)
; =========================================================
(defrule
    (current-age == dark-age)
    (housing-headroom < 4)
    (up-pending-objects c: house == 0)
    (can-build house)
=>
    (build house)
)

(defrule
    (building-type-count-total town-center == 0)
    (wood-amount > 275)
    (stone-amount > 100)
    (can-build town-center)
=>
    (build town-center)
)

(defrule
    (current-age == castle-age)
    (building-type-count-total town-center < 3)
    (wood-amount > 350)
    (stone-amount > 100)
    (up-pending-objects c: town-center == 0)
    (can-build town-center)
=>
    (build town-center)
)

; =========================================================
; 1.5 AWANS DO EPOKI ZAMKOWEJ I PROTOKÓŁ OSZCZĘDZANIA
; =========================================================
(defrule
    (current-age == feudal-age)
    (building-type-count-total blacksmith < 1)
    (can-build blacksmith)
=>
    (build blacksmith)
)

(defrule
    (current-age == feudal-age)
    (building-type-count-total archery-range < 1)
    (building-type-count-total stable < 1)
    (building-type-count-total market < 1)
    (can-build market)
=>
    (build market)
)

(defrule
    (current-age == feudal-age)
    (food-amount > 600)
    (gold-amount > 150)
=>
    (set-escrow-percentage food 100)
    (set-escrow-percentage gold 100)
)

(defrule
    (can-research-with-escrow castle-age)
=>
    (release-escrow food)
    (release-escrow gold)
    (research castle-age)
)

; =========================================================
; 2. DYNAMICZNA PRZESTRZEŃ I BUDOWANIE DOMKÓW
; =========================================================
(defrule
    (current-age == feudal-age)
    (strategic-number sn-maximum-town-size < 45)
=>
    (set-strategic-number sn-maximum-town-size 45)
)

(defrule
    (current-age == castle-age)
    (strategic-number sn-maximum-town-size < 65)
=>
    (set-strategic-number sn-maximum-town-size 65)
)

(defrule
    (housing-headroom < 5)
    (up-pending-objects c: house < 1)
    (can-build house)
=>
    (build house)
)

(defrule
    (current-age >= feudal-age)
    (housing-headroom < 12)
    (up-pending-objects c: house < 2)
    (can-build house)
=>
    (build house)
)

; =========================================================
; 3. TECHNOLOGIE TOWN CENTER & AWANSE
; =========================================================
(defrule
    (up-compare-const f-loom == 1)
    (can-research ri-loom)
=>
    (research ri-loom)
)

(defrule
    (unit-type-count-total villager >= f-feudal-vills)
    (can-research feudal-age)
=>
    (research feudal-age)
)

(defrule
    (up-compare-const f-wheelbarrow == 1)
    (can-research ri-wheel-barrow)
=>
    (research ri-wheel-barrow)
)

(defrule
    (unit-type-count-total villager >= f-castle-vills)
    (can-research castle-age)
=>
    (research castle-age)
)

; =========================================================
; 4. TWORZENIE WIEŚNIAKÓW
; =========================================================
(defrule (current-age == dark-age) (unit-type-count-total villager < f-feudal-vills) (can-train villager) => (train villager))
(defrule (current-age == feudal-age) (unit-type-count-total villager < f-castle-vills) (can-train villager) => (train villager))
(defrule (current-age >= castle-age) (unit-type-count-total villager < 100) (can-train villager) => (train villager))

; =========================================================
; 5. BUDOWNICTWO (GOSPODARKA I INFRASTRUKTURA BAZOWA)
; =========================================================
(defrule (building-type-count-total mill == 0) (can-build mill) => (build mill))
(defrule (building-type-count-total lumber-camp == 0) (can-build lumber-camp) => (build lumber-camp))
(defrule (building-type-count-total lumber-camp >= 1) (building-type-count-total mining-camp == 0) (can-build mining-camp) => (build mining-camp))

(defrule (building-type-count-total mill >= 1) (wood-amount >= 60) (idle-farm-count == 0) (can-build farm) => (build farm))
(defrule (building-type-count-total barracks == 0) (can-build barracks) => (build barracks))

(defrule (up-compare-const f-palisade == 1) (can-build-wall 1 palisade-wall) => (build-wall 1 palisade-wall))
(defrule (up-compare-const f-market == 1) (building-type-count-total market == 0) (can-build market) => (build market))
(defrule (up-compare-const f-blacksmith == 1) (building-type-count-total blacksmith == 0) (can-build blacksmith) => (build blacksmith))
(defrule (up-compare-const f-archery == 1) (building-type-count-total archery-range == 0) (can-build archery-range) => (build archery-range))
(defrule (up-compare-const f-stable == 1) (building-type-count-total stable == 0) (can-build stable) => (build stable))
(defrule (up-compare-const f-tower == 1) (building-type-count-total watch-tower == 0) (can-build watch-tower) => (build watch-tower))
(defrule (up-compare-const f-siege == 1) (current-age >= castle-age) (building-type-count-total siege-workshop == 0) (can-build siege-workshop) => (build siege-workshop))

; =========================================================
; BUDOWA ZAMKU
; =========================================================
(defrule
    (up-compare-const f-castle == 1)
    (current-age >= castle-age)
    (stone-amount >= 650)
    (building-type-count-total castle < 2)
    (up-pending-objects c: castle < 1)
    (can-build castle)
=>
    (build castle)
)

(defrule
    (building-type-count-total market > 0)
    (stone-amount > 800)
    (building-type-count-total castle >= 2)
    (can-sell-commodity stone)
=>
    (sell-commodity stone)
)

; =========================================================
; NIESKOŃCZONA EKSPANSJA GOSPODARCZA
; =========================================================
(defrule
    (building-type-count-total farm > 14)
    (building-type-count-total mill < 2)
    (up-pending-objects c: mill == 0)
    (can-build mill)
=>
    (build mill)
)

(defrule
    (building-type-count-total farm > 26)
    (building-type-count-total mill < 3)
    (up-pending-objects c: mill == 0)
    (can-build mill)
=>
    (build mill)
)

(defrule
    (dropsite-min-distance wood > 4)
    (wood-amount > 150)
    (up-pending-objects c: lumber-camp == 0)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

(defrule
    (dropsite-min-distance gold > 5)
    (wood-amount > 150)
    (up-pending-objects c: mining-camp == 0)
    (can-build mining-camp)
=>
    (build mining-camp)
)

(defrule
    (dropsite-min-distance stone > 5)
    (strategic-number sn-stone-gatherer-percentage > 0)
    (wood-amount > 150)
    (up-pending-objects c: mining-camp == 0)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; =========================================================
; 6. TECHNOLOGIE POBOCZNE
; =========================================================
(defrule (up-compare-const f-doubleaxe == 1) (can-research ri-double-bit-axe) => (research ri-double-bit-axe))
(defrule (up-compare-const f-horsecollar == 1) (can-research ri-horse-collar) => (research ri-horse-collar))
(defrule (up-compare-const f-goldmining == 1) (can-research ri-gold-mining) => (research ri-gold-mining))
(defrule (up-compare-const f-fletching == 1) (can-research ri-fletching) => (research ri-fletching))
(defrule (up-compare-const f-paddedarcher == 1) (can-research ri-padded-archer-armor) => (research ri-padded-archer-armor))
(defrule (up-compare-const f-forging == 1) (can-research ri-forging) => (research ri-forging))
(defrule (up-compare-const f-scalemail == 1) (can-research ri-scale-mail) => (research ri-scale-mail))

; =========================================================
; AUTOMATYCZNE ULEPSZENIA LINII WOJSKOWYCH
; =========================================================
(defrule (can-research ri-man-at-arms) => (research ri-man-at-arms))
(defrule (can-research ri-long-swordsman) => (research ri-long-swordsman))
(defrule (can-research ri-crossbow) => (research ri-crossbow))
(defrule (can-research ri-elite-skirmisher) => (research ri-elite-skirmisher))
(defrule (can-research ri-light-cavalry) => (research ri-light-cavalry))
(defrule (can-research ri-pikeman) => (research ri-pikeman))

; =========================================================
; 7. WOJSKO (PRODUKCJA)
; =========================================================
(defrule (unit-type-count-total militiaman-line < f-militia-count) (can-train-with-escrow militiaman-line) => (train militiaman-line))
(defrule (unit-type-count-total archer-line < f-archer-count) (can-train-with-escrow archer-line) => (train archer-line))
(defrule (unit-type-count-total skirmisher-line < f-skirm-count) (can-train-with-escrow skirmisher-line) => (train skirmisher-line))
(defrule (unit-type-count-total scout-cavalry-line < f-scout-count) (can-train-with-escrow scout-cavalry-line) => (train scout-cavalry-line))
(defrule (unit-type-count-total spearman-line < f-spearman-count) (can-train-with-escrow spearman-line) => (train spearman-line))
(defrule (unit-type-count-total knight-line < f-knight-count) (can-train-with-escrow knight-line) => (train knight-line))

(defrule
    (current-age == castle-age)
    (building-type-count-total siege-workshop > 0)
    (unit-type-count-total battering-ram-line < f-ram-count)
    (can-train battering-ram-line)
=>
    (train battering-ram-line)
)

; =========================================================
; 8. TAKTYKA, GRUPOWANIE I LOKALNA INTELIGENCJA BOJOWA
; =========================================================
(defrule
    (true)
=>
    (up-find-player enemy 2 gl-target-player)
)

(defrule
    (up-compare-goal gl-target-player > 0)
=>
    (up-modify-sn sn-focus-player-number g:= gl-target-player)
    (up-modify-sn sn-target-player-number g:= gl-target-player)
)

(defrule
    (current-age >= feudal-age)
=>
    ; Sterowniki taktyczne UserPatcha – zmuszają armię do formowania grup zamiast stania w miejscu
    (set-strategic-number sn-task-ungrouped-soldiers 1)
    (set-strategic-number sn-number-attack-groups f-attack-groups)
    (set-strategic-number sn-gather-idle-soldiers-at-center 1)
    (set-strategic-number sn-minimum-attack-group-size f-min-attack-group)
    (set-strategic-number sn-maximum-attack-group-size f-attack-group-size)
    (disable-self)
)

(defrule
    (current-age >= feudal-age)
    (up-compare-const f-target-eco == 1)
=>
    (set-strategic-number sn-special-attack-type1 villager)
    (set-strategic-number sn-special-attack-type2 lumber-camp)
    (set-strategic-number sn-special-attack-type3 mining-camp)
    (set-strategic-number sn-target-evaluation-distance 1)
    (disable-self)
)

; =========================================================
; DYNAMICZNE MORALE (ZABEZPIECZENIE PRZED SAMOBÓJSTWEM)
; =========================================================
(defrule
    (military-population > 15)
    (strategic-number sn-percent-attack-soldiers > 0)
=>
    (set-strategic-number sn-target-evaluation-damage-capability -10)
)

(defrule
    (military-population < f-retreat-threshold)
    (strategic-number sn-percent-attack-soldiers > 0)
=>
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-target-evaluation-damage-capability 0)
    (set-strategic-number sn-gather-idle-soldiers-at-center 1)
)

; =========================================================
; 9. OBLĘŻENIE I ATAK
; =========================================================
(defrule
    (current-age == feudal-age)
    (up-compare-const f-feudal-aggression == 1)
    (military-population > f-min-attack-group)
=>
    (set-strategic-number sn-percent-attack-soldiers f-attack-percent)
    (attack-now)
)

(defrule
    (current-age == castle-age)
    (unit-type-count-total battering-ram-line > 0)
    (military-population > f-army-size-with-siege)
=>
    (set-strategic-number sn-percent-attack-soldiers f-attack-percent)
    (attack-now)
)

(defrule
    (current-age == castle-age)
    (unit-type-count-total battering-ram-line == 0)
    (military-population > f-army-size-no-siege)
=>
    (set-strategic-number sn-percent-attack-soldiers f-attack-percent)
    (attack-now)
)

; =========================================================
; 10. PROTOKÓŁ NADWYŻKI
; =========================================================
(defrule
    (current-age == castle-age)
    (wood-amount > 250)
    (building-type-count-total barracks < 3)
    (can-build barracks)
=>
    (build barracks)
)

(defrule
    (current-age == castle-age)
    (wood-amount > 300)
    (up-compare-const f-archery == 1)
    (building-type-count-total archery-range < 3)
    (can-build archery-range)
=>
    (build archery-range)
)

(defrule
    (current-age == castle-age)
    (wood-amount > 300)
    (up-compare-const f-stable == 1)
    (building-type-count-total stable < 3)
    (can-build stable)
=>
    (build stable)
)

(defrule
    (current-age == castle-age)
    (wood-amount > 350)
    (up-compare-const f-siege == 1)
    (building-type-count-total siege-workshop < 2)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)

; =========================================================
; 11. ZGODNA Z USERPATCH 1.5 TELEMETRIA (RAM READ)
; =========================================================
(defrule
    (game-time > {{MATCH_DURATION}})
=>
    (resign)
)